# FraudLens server settings. On Render these are "Environment Variables" (see render.yaml).
# On your own computer, the Windows helper reads ..\MY_KEYS.txt (kept OUTSIDE this folder so it is
# never uploaded). Put each value right after "=", with nothing else on the line.

# ---- Free threat-intelligence keys (all optional; leave empty if you don't have one) ----
# Google Safe Browsing (free, Google Cloud project, "Safe Browsing API", restrict the key to it)
FRAUDLENS_SAFE_BROWSING_KEY=
# URLhaus / abuse.ch Auth-Key (free: https://auth.abuse.ch/)
FRAUDLENS_URLHAUS_KEY=
# VirusTotal public API key (free: https://www.virustotal.com/gui/join-us -> your profile -> API key)
FRAUDLENS_VIRUSTOTAL_KEY=
# OpenPhish live phishing list: free, no key, on by default
FRAUDLENS_OPENPHISH_ENABLED=true

# ---- Free AI explanations (optional; rules + our own ML models work without it) ----
# auto = use whichever key below is filled in (Groq first)
FRAUDLENS_AI_PROVIDER=auto
# Groq (free, no card: https://console.groq.com/keys)
FRAUDLENS_GROQ_API_KEY=
FRAUDLENS_GROQ_MODEL=openai/gpt-oss-20b
# Google Gemini (free tier: https://aistudio.google.com/apikey; free-tier data may be used by Google)
FRAUDLENS_GEMINI_API_KEY=
FRAUDLENS_GEMINI_MODEL=gemini-3.1-flash-lite

# ---- Optional phone-risk services (trial / limited) ----
FRAUDLENS_TELESIGN_CUSTOMER_ID=
FRAUDLENS_TELESIGN_API_KEY=
FRAUDLENS_IPQS_KEY=

# ---- Behaviour ----
# 1 = one report teaches FraudLens immediately (good for a live demo); 2-3 resists poisoning
FRAUDLENS_REPORT_CONFIRMATIONS=1
# Every API call needs the signed install token the Chrome extension gets automatically
FRAUDLENS_REQUIRE_INSTALL_TOKEN=true
# Protects /admin endpoints; 24+ random characters, otherwise admin stays LOCKED (recommended)
FRAUDLENS_ADMIN_TOKEN=
