# Copy to .env and adjust.

# AI layer: "none" (rules only, works offline) or "anthropic"
FRAUDLENS_AI_PROVIDER=none
FRAUDLENS_ANTHROPIC_API_KEY=
FRAUDLENS_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
FRAUDLENS_AI_TIMEOUT_SECONDS=8

# Risk thresholds (0-100)
FRAUDLENS_MEDIUM_RISK_THRESHOLD=30
FRAUDLENS_HIGH_RISK_THRESHOLD=60

# Pause-Before-Pay
FRAUDLENS_PAUSE_COOLDOWN_SECONDS=10
FRAUDLENS_LARGE_PAYMENT_THRESHOLD=10000

# ML verification layer
FRAUDLENS_ML_ENABLED=true
FRAUDLENS_EMBEDDER=auto                 # auto | e5 | hashing
FRAUDLENS_REPORT_CONFIRMATIONS=2        # set to 1 for the live-learning demo
# Protects /admin/retrain and /admin/rollback. Leave empty to disable them, or use 16+ random characters
# (e.g. python -c "import secrets;print(secrets.token_urlsafe(24))")
FRAUDLENS_ADMIN_TOKEN=
# Per-device limit for analyze / report / intel lookups (0 = off)
FRAUDLENS_RATE_LIMIT_PER_MINUTE=30
FRAUDLENS_ONNX_THREADS=2

# Threat intelligence (live checks of links and phone numbers)
# Put your real keys ONLY in backend/.env (git-ignored). Never commit them or put them in the code zip.
# Keep comments on their own line: text after "=" is read as the value.
FRAUDLENS_INTEL_ENABLED=true
# Total time budget per message (seconds); slow providers are skipped
FRAUDLENS_INTEL_TIMEOUT_SECONDS=2.5
# Google Cloud API key, restricted to the Safe Browsing API
FRAUDLENS_SAFE_BROWSING_KEY=AIzaSyC7yUnxYfb8cTSrlvc_pbn4HKyf_1YTPfo
# abuse.ch Auth-Key (URLhaus)
FRAUDLENS_URLHAUS_KEY=e08bb3bf5f284dea7cfa7a768b9f9d3df0bb27a588560550
# IPQualityScore key (free plan: 35 lookups/day, 1000/month)
FRAUDLENS_IPQS_KEY=MWjPzjmQlZadFrCetftLmIvbTK2DphOu
FRAUDLENS_IPQS_DAILY_LIMIT=30
FRAUDLENS_IPQS_COUNTRY=MU
# Domain age via RDAP (no key needed) and unmasking of bit.ly-style links (only the shortener is contacted)
FRAUDLENS_RDAP_ENABLED=true
FRAUDLENS_EXPAND_SHORT_LINKS=true
