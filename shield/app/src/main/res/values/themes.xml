        <item name="android:windowBackground">@color/fl_bg</item>
        <item name="android:colorBackground">@color/fl_bg</item>
        <item name="android:colorAccent">@color/fl_safe</item>
        <item name="android:colorPrimary">@color/fl_surface</item>
        <item name="android:colorPrimaryDark">@color/fl_bg</item>
